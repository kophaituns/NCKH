# [GAU] Root .gitignore for Monorepo
# Chặn các file môi trường và bí mật
.env
**/.env
**/.env.*
!**/.env.example

# Chặn thư viện và môi trường ảo
**/node_modules/
**/.venv/
**/__pycache__/

# Chặn dữ liệu AI và Database (Dữ liệu cá nhân/nặng)
**/chroma_db/
**/chroma-data/
**/user_data/
**/datasets/
**/question_datasets/
**/*.sqlite
**/*.db
**/*.pkl
**/*.joblib

# Chặn rác của hệ điều hành và IDE
.vscode/
.idea/
.DS_Store
Thumbs.db
**/*.tmp
**/*.log

# Chặn các file export/backup
**/form_agent_export_*.json
scratch_*.py
prompt_recover.py
docs/
logs/
